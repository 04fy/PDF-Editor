{
  "name": "html-pdf-modifier",
  "version": "1.0.0",
  "description": "Browser based PDF editor: text, images, shapes, form fields and page layout, in every writing system. Runs entirely offline, nothing is uploaded.",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node test/run-tests.js",
    "test:dom": "node test/dom-smoke.js",
    "test:all": "npm test && npm run test:dom"
  },
  "devDependencies": {
    "jsdom": "^24.1.3"
  },
  "keywords": [
    "pdf",
    "editor",
    "pdf.js",
    "pdf-lib",
    "rtl",
    "unicode",
    "offline"
  ],
  "license": "MIT"
}
